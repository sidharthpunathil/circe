# Copy to .env for local development. Every value is optional.

# Where the site listens. Most hosts inject PORT themselves.
# PORT=8080
# CIRCE_ADDR=127.0.0.1:8080

# Where the registry's database lives. Back it up by exporting
# (`circe-server export`) or by syncing to a repository, not by copying this
# directory while the server is running.
# CIRCE_DATA=./data

# Protect the registry. Required for any deployment reachable from the internet.
# Without a password, anyone who can load the page can edit and delete skills.
# CIRCE_PASSWORD=change-me
# CIRCE_USER=admin

# Remove the PocketBase dashboard at /_/ and its REST API. It is already behind
# CIRCE_PASSWORD, with its own superuser account as a second lock, so this is
# for when you would rather it not exist at all.
# CIRCE_NO_DASHBOARD=1

# Public origin, if running behind a proxy or custom domain.
# CIRCE_BASE_URL=https://skills.example.com

# On first boot, when the registry is empty, import every skill from this repo.
# Accepts owner/repo, a full URL, or a link to a subdirectory or tag.
# CIRCE_SEED_REPO=owner/repo
# CIRCE_SEED_FOLDER=starter
# CIRCE_SEED_FOLDER_TITLE=Starter Pack

# Raises the GitHub API rate limit (60/hour unauthenticated) and reaches
# private repositories. Strongly recommended if you import from GitHub, and
# required to sync: for that it needs Contents: read and write on the
# repository you sync with.
# GITHUB_TOKEN=ghp_...
